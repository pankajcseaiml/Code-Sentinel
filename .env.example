# ==============================================================================
# CODE SENTINEL - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL
# Store production credentials securely in KeePassXC (scripts/vault_manager.py)
# ==============================================================================

# Database Connection (PostgreSQL 16)
# Example: postgresql://username:password@localhost:5432/codesentinel
DATABASE_URL=postgresql://codesentinel:replace_with_secure_password@localhost:5432/codesentinel

# JWT Authentication Configuration
# Generate a secure 256-bit random string for production
JWT_SECRET=replace_with_secure_random_jwt_secret_key
JWT_EXPIRES_IN=7d

# Frontend Application Configuration
NEXT_PUBLIC_API_URL=http://localhost:3400

# Optional OpenCode Data Overrides
# OPENCODE_STORAGE_ROOT=~/.local/share/opencode/storage
# CC_VIEWER_NO_AUTO_OPEN=1
